# This file is included after the makefile generated by Lemu.  It deliberately
# uses the generated object groups instead of a global CXXFLAGS override: the
# generated model needs the full large code model, while runtime/user objects
# need the large model only to call into the high-address model island.

LEMU_LARGE_MODEL_CXXFLAGS := \
  -mcmodel=large \
  -fno-exceptions \
  -fno-unwind-tables \
  -fno-asynchronous-unwind-tables
LEMU_LARGE_RUNTIME_CXXFLAGS := -mcmodel=large
LEMU_LARGE_MODEL_MK ?= $(NOOP_HOME)/difftest/src/test/csrc/lemu/large-model.mk
LEMU_LARGE_MODEL_LINKER_SCRIPT ?= $(NOOP_HOME)/difftest/src/test/csrc/lemu/large-model.ld

# The generated Lemu archive recipe invokes $(AR) -rc directly.  A regular
# archive duplicates every generated object (a 96-way trace model can exceed
# the available disk space), while a thin archive keeps references to those
# objects in place.  GNU ar accepts -T before the recipe's -rc/-rcs options.
# If hierarchical archives are present, keep the regular archive mode because
# the generated merge recipe extracts those archives into a temporary tree.
LEMU_LARGE_MODEL_AR ?= $(if $(strip $(AR)),$(AR),ar)
ifeq ($(strip $(LEMU_MODEL_HIER_LIBS)),)
override AR := $(LEMU_LARGE_MODEL_AR) -T
endif

# LEMU_BUILD_OBJS is the aggregate/parallel-build list selected by lemurt.mk.  Include
# the fast/slow lists explicitly as well so the rule remains correct when a
# generated makefile is invoked without LEMU_MODEL_PARALLEL_BUILDS=1.
LEMU_LARGE_MODEL_OBJS := $(sort $(LEMU_BUILD_OBJS) $(LEMU_BUILD_OBJS_FAST) $(LEMU_BUILD_OBJS_SLOW))
LEMU_LARGE_MODEL_RUNTIME_OBJS := $(sort $(LEMU_BUILD_USER_OBJS) $(LEMU_BUILD_GLOBAL_OBJS) $(LEMU_MODEL_LCC_OBJS))
LEMU_LARGE_MODEL_ALL_OBJS := $(sort $(LEMU_LARGE_MODEL_OBJS) $(LEMU_LARGE_MODEL_RUNTIME_OBJS))
ifneq ($(strip $(LEMU_LARGE_MODEL_ALL_OBJS)),)
$(LEMU_LARGE_MODEL_ALL_OBJS) $(LEMU_BUILD_PCH_H).fast.gch $(LEMU_BUILD_PCH_H).slow.gch: $(LEMU_LARGE_MODEL_MK)
endif
ifneq ($(strip $(LEMU_LARGE_MODEL_OBJS)),)
$(LEMU_LARGE_MODEL_OBJS) $(LEMU_BUILD_PCH_H).fast.gch $(LEMU_BUILD_PCH_H).slow.gch: private override CXXFLAGS += $(LEMU_LARGE_MODEL_CXXFLAGS)
endif
ifneq ($(strip $(LEMU_LARGE_MODEL_RUNTIME_OBJS)),)
$(LEMU_LARGE_MODEL_RUNTIME_OBJS): private override CXXFLAGS += $(LEMU_LARGE_RUNTIME_CXXFLAGS)
endif

ifneq ($(strip $(LEMU_LARGE_MODEL_TARGET)),)
$(LEMU_LARGE_MODEL_TARGET): $(LEMU_LARGE_MODEL_LINKER_SCRIPT)
endif

# Keep the CRT/runtime island at low addresses and place the generated model
# sections in the high-address island described by the linker script.
LDFLAGS += -fuse-ld=bfd -no-pie -Wl,--no-relax -Wl,-T,$(LEMU_LARGE_MODEL_LINKER_SCRIPT)
